
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Book Notes</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>📚 Book Notes</h1>
            <p class="subtitle">Your digital bookshelf, powered by Firebase.</p>
        </header>

        <div class="add-book-section">
            <% if (message) { %>
                <div class="alert">
                    <strong>Note:</strong> <%= message %>
                    <button class="close-btn" onclick="this.parentElement.style.display='none'">&times;</button>
                </div>
            <% } %>
            <h2>Add a New Book</h2>
            <form action="/addBook" method="POST">
                <div class="form-group">
                    <input type="text" name="title" placeholder="Enter a book title..." required autocomplete="off">
                    <select name="rating" required>
                        <option value="" disabled selected>Select a rating</option>
                        <option value="5">⭐⭐⭐⭐⭐</option>
                        <option value="4">⭐⭐⭐⭐</option>
                        <option value="3">⭐⭐⭐</option>
                        <option value="2">⭐⭐</option>
                        <option value="1">⭐</option>
                    </select>
                    <button type="submit">Add Book</button>
                </div>
            </form>
        </div>

        <div class="books-section">
            <% if (books && books.length > 0) { %>
                <% books.forEach(function(book, index) { %>
                    <div class="book-card" style="animation-delay: <%= index * 100 %>ms;">
                        <div class="book-cover">
                            <img src="<%= book.coverPageUrl %>" alt="Cover of <%= book.title %>" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="book-cover-placeholder" style="display: none;">📖</div>
                        </div>
                        <div class="book-info">
                            <h3 class="book-title"><%= book.title %></h3>
                            <p class="book-author">by <%= book.author %></p>
                            <div class="book-rating">
                                <% for(let i = 0; i < 5; i++) { %>
                                    <span class="star"><%= i < book.rating ? '★' : '☆' %></span>
                                <% } %>
                            </div>
                            <form action="/deleteBook" method="POST">
                                <input type="hidden" name="bookId" value="<%= book.id %>">
                                <button type="submit" class="delete-btn">Remove</button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">📚</div>
                    <h2>Your Bookshelf is Empty</h2>
                    <p>Add your first book to get started.</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
